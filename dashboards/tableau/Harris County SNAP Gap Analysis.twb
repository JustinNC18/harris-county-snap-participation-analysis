      <column caption='Estimated SNAP Participation Opportunity' datatype='string' name='[High Poverty-&lt;50% Participation (copy)_0148195822133250]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [eligible_125_fpl_pct] &lt; 0.10 &#13;&#10;THEN &quot;Lower Poverty Areas&quot;&#13;&#10;&#13;&#10;ELSEIF [eligible_125_fpl_pct] &gt;= 0.20 AND [participation_rate] &lt; 0.50 &#13;&#10;THEN &quot;Highest Opportunity (&lt;50% and FPL &gt;20%)&quot;&#13;&#10;&#13;&#10;ELSEIF [eligible_125_fpl_pct] &gt;= 0.10 AND [participation_rate] &lt; 0.50 &#13;&#10;THEN &quot;Higher Opportunity (&lt;50%)&quot;&#13;&#10;&#13;&#10;ELSEIF [eligible_125_fpl_pct] &gt;= 0.10 AND [participation_rate] &lt; 0.60 &#13;&#10;THEN &quot;Moderate-High (50%-60%)&quot;&#13;&#10;&#13;&#10;ELSEIF [eligible_125_fpl_pct] &gt;= 0.10 AND [participation_rate] &lt; 0.70 &#13;&#10;THEN &quot;Moderate (60%-70%)&quot;&#13;&#10;&#13;&#10;ELSE &quot;Lower Opportunity (&gt;70%)&quot;&#13;&#10;END' />
      </column>
